# Notice Decoder - Environment Configuration Template

# GEMINI_API_KEY: Required for Gemini 3.8 Flash multimodal & text notice extraction.
# AI Studio automatically injects this at runtime from user secrets.
# When omitted, the applet gracefully falls back to the deterministic local parser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional for production multi-user database & RLS)
# When provided, Notice Decoder connects to real PostgreSQL with Row Level Security.
# When absent, Notice Decoder seamlessly runs on an isolated local development repository.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# EXTERNAL NOTIFICATION DISPATCH (Optional)
# In-app notifications and scheduled reminders operate natively without credentials.
# If configured, emails are dispatched concurrently with in-app reminders.
SMTP_HOST="smtp.college.edu"
SMTP_PORT="587"
SMTP_USER="notifications@college.edu"
SMTP_PASS="your-smtp-password"

# WEB PUSH VAPID KEYS (Optional)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
